---
import ContactEmail from './ContactEmail.astro';
import { AUTHOR_NAME, AUTHOR_GITHUB, AUTHOR_GITHUB_HANDLE } from '../consts';
---
<footer class="site-footer">
  <div class="footer-contact">
    <a href={AUTHOR_GITHUB} target="_blank" rel="noopener noreferrer" class="footer-link">
      GitHub / {AUTHOR_GITHUB_HANDLE}
    </a>
    <ContactEmail size="sm" />
  </div>

  <p class="footer-copy">&copy; {new Date().getFullYear()} {AUTHOR_NAME}. All rights reserved.</p>
</footer>

<style>
.site-footer {
  text-align: center;
  padding: 2rem 1rem;
  color: #6b7280;
  border-top: 1px solid #e5e7eb;
  margin-top: 3rem;
}
.footer-contact {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 1.25rem;
  margin-bottom: 1rem;
}
.footer-link {
  font-size: 0.95rem;
}
.footer-copy {
  font-size: 0.9rem;
  margin: 0;
}
</style>

---
/**
 * 文章卡片：缩略图 + 标题 + 摘要 + 日期 + 标签
 * data-tags 供首页的标签筛选脚本读取
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  /** 精选卡片放大展示 */
  featured?: boolean;
  /** 摘要最大字数 */
  maxLength?: number;
}

const { post, featured = false, maxLength = 72 } = Astro.props;

// 摘要优先用 description；没写就从正文提取纯文本
const desc = post.data.description?.trim() ?? '';
const bodyText = String(post.body ?? '')
  .replace(/^---[\s\S]*?---/, '')      // 去掉 frontmatter
  .replace(/```[\s\S]*?```/g, ' ')     // 去掉代码块
  .replace(/[#*>`_\[\]()!~|]/g, ' ')   // 去掉 Markdown 标记
  .replace(/\s+/g, ' ')
  .trim();
const source = desc || bodyText;
const summary = source.length > maxLength ? `${source.slice(0, maxLength)}…` : source;

const tags = post.data.tags ?? [];
const dateText = new Date(post.data.pubDate).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<article class:list={['post-card', { featured }]} data-tags={tags.join(',')}>
  <a class="card-link" href={`/blog/${post.id}`}>
    <div class="card-thumb">
      {
        post.data.heroImage ? (
          <Image width={480} height={270} src={post.data.heroImage} alt="" />
        ) : (
          <span class="thumb-fallback" aria-hidden="true">{post.data.title.slice(0, 1)}</span>
        )
      }
    </div>

    <div class="card-main">
      <h3 class="card-title">{post.data.title}</h3>
      {summary && <p class="card-summary">{summary}</p>}
      <div class="card-meta">
        <time datetime={post.data.pubDate.toISOString()}>{dateText}</time>
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </div>
  </a>
</article>

<style>
  .post-card {
    width: 100%;
  }
  .card-link {
    display: flex;
    gap: 1rem;
    align-items: stretch;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border: 1px solid #e8eaef;
    border-radius: 14px;
    padding: 0.85rem;
    height: 100%;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .card-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(37, 99, 235, 0.1);
    border-color: #c7d2fe;
  }

  .card-thumb {
    flex: 0 0 108px;
    width: 108px;
    border-radius: 10px;
    overflow: hidden;
    background: linear-gradient(135deg, #e0e7ff, #f1f5f9);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .thumb-fallback {
    font-size: 2rem;
    font-weight: 700;
    color: #a5b4fc;
    user-select: none;
  }

  .card-main {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.3rem;
  }
  .card-title {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.4;
    color: #1f2937;
  }
  .card-link:hover .card-title {
    color: #2563eb;
  }
  .card-summary {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: #6b7280;
    /* 最多两行，超出省略 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.1rem;
    font-size: 0.78rem;
    color: #9ca3af;
  }
  .tag {
    background: #eef2ff;
    color: #4f46e5;
    border-radius: 999px;
    padding: 0.05rem 0.5rem;
    font-size: 0.72rem;
  }

  /* 精选卡片：整行铺开，缩略图更大 */
  .featured .card-link {
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }
  .featured .card-thumb {
    flex: none;
    width: 100%;
    height: 210px;
    border-radius: 0;
  }
  .featured .thumb-fallback {
    font-size: 4rem;
  }
  .featured .card-main {
    padding: 1.1rem 1.25rem 1.25rem;
  }
  .featured .card-title {
    font-size: 1.5rem;
  }
  .featured .card-summary {
    font-size: 0.95rem;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  @media (max-width: 640px) {
    .card-link {
      flex-direction: column;
    }
    .card-thumb {
      flex: none;
      width: 100%;
      height: 140px;
    }
    .featured .card-thumb {
      height: 160px;
    }
    .featured .card-title {
      font-size: 1.25rem;
    }
  }
</style>

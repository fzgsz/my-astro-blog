---
import AboutHeroImage from '../assets/blog-placeholder-about.jpg';
import Layout from '../layouts/BlogPost.astro';
import ContactEmail from '../components/ContactEmail.astro';
import { AUTHOR_NAME, AUTHOR_GITHUB, AUTHOR_GITHUB_HANDLE } from '../consts';
---

<Layout
	title="关于我"
	description={`关于这个博客和它的作者 ${AUTHOR_NAME}`}
	pubDate={new Date('August 08 2021')}
	heroImage={AboutHeroImage}
	hideDate
>
	<p>
		你好，我是{AUTHOR_NAME}。这里是我用来记录技术笔记、学习心得和一些零散思考的地方。
	</p>

	<p>
		文章大多围绕我在学习过程中实际遇到的问题展开——踩过的坑、排查的思路、最后的解法。
		写下来一是给自己备忘，二是希望后来遇到同样问题的人能少绕一点弯路。
	</p>

	<p>
		内容会持续更新。如果你对某篇文章有疑问，或者发现哪里有讲错的地方，欢迎直接找我。
	</p>

	<h2>联系我</h2>
	<ul class="contact-list">
		<li>
			<span class="contact-label">邮箱</span>
			<ContactEmail size="sm" />
		</li>
		<li>
			<span class="contact-label">GitHub</span>
			<a href={AUTHOR_GITHUB} target="_blank" rel="noopener noreferrer">{AUTHOR_GITHUB_HANDLE}</a>
		</li>
	</ul>
</Layout>

<style>
.contact-list {
	list-style: none;
	padding: 0;
	margin: 1.25rem 0 0;
	display: flex;
	flex-direction: column;
	gap: 0.65rem;
}
.contact-list li {
	display: flex;
	align-items: center;
	gap: 0.75rem;
}
.contact-label {
	color: #6b7280;
	min-width: 3.5rem;
}
</style>

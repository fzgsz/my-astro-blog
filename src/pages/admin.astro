---
/**
 * 本地写作台 —— 像发帖一样写博客
 *
 * 用法：pnpm dev 后打开 http://localhost:4321/admin
 * 保存端点由 scripts/writer-plugin.mjs 提供，只在 dev server 存在。
 */
import BaseHead from '../components/BaseHead.astro';

const isDev = import.meta.env.DEV;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <BaseHead title="写作台" description="本地写作台" />
</head>
<body>
  {
    isDev ? (
      <div class="writer">
        <header class="topbar">
          <div>
            <h1>写作台</h1>
            <p class="sub">写完点「发布」，文件自动存进 <code>src/content/blog/</code></p>
          </div>
          <span class="badge">仅本地可用</span>
        </header>

        <section class="meta">
          <label class="field field--title">
            <span>标题</span>
            <input id="f-title" type="text" placeholder="给这篇文章起个名字" autocomplete="off" />
          </label>
          <label class="field">
            <span>一句话描述</span>
            <input id="f-desc" type="text" placeholder="显示在首页卡片上，可留空" autocomplete="off" />
          </label>
          <label class="field">
            <span>标签</span>
            <input id="f-tags" type="text" placeholder="用逗号分隔，可留空，例：学习笔记, Astro" autocomplete="off" />
          </label>
          <label class="field">
            <span>链接标识</span>
            <input id="f-slug" type="text" placeholder="英文或拼音，留空则用日期" autocomplete="off" />
          </label>
        </section>

        <div class="toolbar">
          <button type="button" data-prefix="## ">大标题</button>
          <button type="button" data-prefix="### ">小标题</button>
          <span class="divider"></span>
          <button type="button" data-wrap="**"><b>加粗</b></button>
          <button type="button" data-wrap="*"><i>斜体</i></button>
          <span class="divider"></span>
          <button type="button" data-prefix="- ">• 列表</button>
          <button type="button" data-prefix="1. ">1. 列表</button>
          <button type="button" data-prefix="> ">引用</button>
          <button type="button" data-wrap="`">代码</button>
          <button type="button" data-link="1">链接</button>
          <span class="grow"></span>
          <button type="button" class="ghost" id="btn-clear">清空</button>
        </div>

        <div class="panes">
          <textarea id="editor" placeholder="在这里写正文，和平时聊天一样，回车分段就行。&#10;&#10;需要小标题或列表时，点上面的按钮。"></textarea>
          <div class="preview" id="preview">
            <p class="preview-empty">右边会实时显示文章最终的样子</p>
          </div>
        </div>

        <footer class="actions">
          <button type="button" class="primary" id="btn-save">发布</button>
          <span class="status" id="status"></span>
        </footer>
      </div>
    ) : (
      <div class="offline">
        <h1>写作台只在本地运行</h1>
        <p>
          这个页面需要本地开发服务器才能保存文件。请在项目目录下运行
          <code>pnpm dev</code>，然后打开 <code>http://localhost:4321/admin</code>。
        </p>
        <p><a href="/">← 回到博客首页</a></p>
      </div>
    )
  }

  <script>
    const $ = (id) => document.getElementById(id);
    const titleEl = $('f-title');
    const descEl = $('f-desc');
    const tagsEl = $('f-tags');
    const slugEl = $('f-slug');
    const editor = $('editor');
    const preview = $('preview');
    const statusEl = $('status');
    const saveBtn = $('btn-save');

    // 元素不存在说明当前不是本地环境，直接跳过全部逻辑
    if (editor && preview && saveBtn) {
      /* ── 极简 Markdown 渲染（够预览用，不追求完整规范） ── */
      const escapeHtml = (s) =>
        s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

      const inline = (s) =>
        escapeHtml(s)
          .replace(/`([^`]+)`/g, '<code>$1</code>')
          .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
          .replace(/\*([^*]+)\*/g, '<em>$1</em>')
          .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');

      function renderMarkdown(src) {
        const blocks = src.split(/\n{2,}/);
        const html = blocks.map((raw) => {
          const block = raw.trim();
          if (!block) return '';

          if (/^```/.test(block)) {
            const body = block.replace(/^```[^\n]*\n?/, '').replace(/\n?```$/, '');
            return `<pre><code>${escapeHtml(body)}</code></pre>`;
          }

          const lines = block.split('\n');

          const heading = block.match(/^(#{1,6})\s+(.+)$/);
          if (heading && lines.length === 1) {
            return `<h${heading[1].length}>${inline(heading[2])}</h${heading[1].length}>`;
          }

          if (lines.every((l) => /^>\s?/.test(l))) {
            return `<blockquote>${inline(lines.map((l) => l.replace(/^>\s?/, '')).join(' '))}</blockquote>`;
          }
          if (lines.every((l) => /^[-*+]\s+/.test(l))) {
            return `<ul>${lines.map((l) => `<li>${inline(l.replace(/^[-*+]\s+/, ''))}</li>`).join('')}</ul>`;
          }
          if (lines.every((l) => /^\d+\.\s+/.test(l))) {
            return `<ol>${lines.map((l) => `<li>${inline(l.replace(/^\d+\.\s+/, ''))}</li>`).join('')}</ol>`;
          }

          return `<p>${lines.map(inline).join('<br>')}</p>`;
        });

        return html.filter(Boolean).join('\n');
      }

      function updatePreview() {
        const html = renderMarkdown(editor.value);
        preview.innerHTML = html || '<p class="preview-empty">右边会实时显示文章最终的样子</p>';
      }

      /* ── 工具栏 ── */
      function wrapSelection(marker) {
        const start = editor.selectionStart;
        const end = editor.selectionEnd;
        const selected = editor.value.slice(start, end) || '文字';
        const next = marker + selected + marker;
        editor.setRangeText(next, start, end, 'end');
        editor.focus();
        editor.setSelectionRange(start + marker.length, start + marker.length + selected.length);
        updatePreview();
      }

      function prefixLine(prefix) {
        const start = editor.selectionStart;
        const lineStart = editor.value.lastIndexOf('\n', start - 1) + 1;
        editor.setRangeText(prefix, lineStart, lineStart, 'end');
        editor.focus();
        updatePreview();
      }

      document.querySelectorAll('.toolbar button').forEach((btn) => {
        btn.addEventListener('click', () => {
          const wrap = btn.getAttribute('data-wrap');
          const prefix = btn.getAttribute('data-prefix');
          if (wrap) return wrapSelection(wrap);
          if (prefix) return prefixLine(prefix);
          if (btn.getAttribute('data-link')) {
            const start = editor.selectionStart;
            const end = editor.selectionEnd;
            const text = editor.value.slice(start, end) || '链接文字';
            const next = `[${text}](https://)`;
            editor.setRangeText(next, start, end, 'end');
            editor.focus();
            editor.setSelectionRange(start + text.length + 3, start + text.length + 11);
            updatePreview();
          }
        });
      });

      $('btn-clear')?.addEventListener('click', () => {
        if (!editor.value.trim() || confirm('确定清空当前内容吗？')) {
          titleEl.value = '';
          descEl.value = '';
          tagsEl.value = '';
          slugEl.value = '';
          editor.value = '';
          updatePreview();
          editor.focus();
        }
      });

      editor.addEventListener('input', updatePreview);

      // Ctrl/Cmd + S 直接发布
      document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
          e.preventDefault();
          saveBtn.click();
        }
      });

      /* ── 发布 ── */
      function setStatus(text, kind) {
        statusEl.textContent = text;
        statusEl.className = `status${kind ? ` status--${kind}` : ''}`;
      }

      saveBtn.addEventListener('click', async () => {
        if (!titleEl.value.trim()) {
          setStatus('先填个标题', 'error');
          titleEl.focus();
          return;
        }
        if (!editor.value.trim()) {
          setStatus('正文还空着', 'error');
          editor.focus();
          return;
        }

        saveBtn.disabled = true;
        setStatus('保存中…');

        try {
          const res = await fetch('/__writer/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              title: titleEl.value,
              description: descEl.value,
              tags: tagsEl.value,
              slug: slugEl.value,
              content: editor.value,
            }),
          });
          const data = await res.json();

          if (!data.ok) throw new Error(data.error || '保存失败');

          setStatus(
            `${data.overwritten ? '已覆盖' : '已创建'} ${data.path}　→　跑 pnpm ship 发布上线`,
            'ok',
          );
        } catch (err) {
          setStatus(`保存失败：${err.message}`, 'error');
        } finally {
          saveBtn.disabled = false;
        }
      });

      updatePreview();
    }
  </script>

  <style>
    :global(body) {
      margin: 0;
    }
    :global(*) {
      box-sizing: border-box;
    }

    .writer {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1.5rem 1.25rem 3rem;
      font-family: var(--font-atkinson, system-ui), 'Microsoft YaHei', sans-serif;
      color: #1f2937;
    }

    .topbar {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .topbar h1 {
      margin: 0 0 0.25rem;
      font-size: 1.6rem;
    }
    .topbar .sub {
      margin: 0;
      font-size: 0.88rem;
      color: #6b7280;
    }
    .topbar code {
      background: #f1f5f9;
      padding: 0.1rem 0.35rem;
      border-radius: 4px;
      font-size: 0.85em;
    }
    .badge {
      flex: 0 0 auto;
      font-size: 0.75rem;
      color: #4f46e5;
      background: #eef2ff;
      border-radius: 999px;
      padding: 0.2rem 0.7rem;
      white-space: nowrap;
    }

    .meta {
      display: grid;
      grid-template-columns: 2fr 2fr 1.4fr 1.2fr;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
    }
    .field {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      min-width: 0;
    }
    .field span {
      font-size: 0.78rem;
      color: #6b7280;
    }
    .field input {
      font-family: inherit;
      font-size: 0.95rem;
      padding: 0.5rem 0.7rem;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      background: #fff;
      color: inherit;
      width: 100%;
    }
    .field input:focus {
      outline: none;
      border-color: #93c5fd;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
    }
    .field--title input {
      font-size: 1.1rem;
      font-weight: 600;
    }

    .toolbar {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.35rem;
      padding: 0.5rem 0.6rem;
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      border-bottom: none;
      border-radius: 10px 10px 0 0;
    }
    .toolbar button {
      font-family: inherit;
      font-size: 0.83rem;
      padding: 0.28rem 0.6rem;
      border: 1px solid transparent;
      border-radius: 6px;
      background: transparent;
      color: #374151;
      cursor: pointer;
    }
    .toolbar button:hover {
      background: #fff;
      border-color: #e5e7eb;
    }
    .toolbar button.ghost {
      color: #9ca3af;
    }
    .toolbar .divider {
      width: 1px;
      height: 18px;
      background: #e5e7eb;
      margin: 0 0.2rem;
    }
    .toolbar .grow {
      flex: 1 1 auto;
    }

    .panes {
      display: grid;
      grid-template-columns: 1fr 1fr;
      border: 1px solid #e5e7eb;
      border-radius: 0 0 10px 10px;
      overflow: hidden;
      min-height: 460px;
    }
    #editor {
      font-family: ui-monospace, SFMono-Regular, Consolas, 'Microsoft YaHei', monospace;
      font-size: 0.95rem;
      line-height: 1.85;
      padding: 1.1rem 1.25rem;
      border: none;
      border-right: 1px solid #e5e7eb;
      resize: none;
      outline: none;
      background: #fff;
      color: #1f2937;
      min-height: 460px;
    }
    .preview {
      padding: 1.1rem 1.4rem;
      background: #fcfcfd;
      overflow-y: auto;
      max-height: 70vh;
      font-size: 0.95rem;
      line-height: 1.8;
    }
    .preview-empty {
      color: #9ca3af;
      font-size: 0.88rem;
    }
    .preview :global(h1),
    .preview :global(h2),
    .preview :global(h3) {
      margin: 1.2em 0 0.5em;
      line-height: 1.35;
    }
    .preview :global(h1) { font-size: 1.7rem; }
    .preview :global(h2) { font-size: 1.35rem; }
    .preview :global(h3) { font-size: 1.12rem; }
    .preview :global(p) { margin: 0 0 1em; }
    .preview :global(ul),
    .preview :global(ol) { padding-left: 1.4em; margin: 0 0 1em; }
    .preview :global(blockquote) {
      margin: 0 0 1em;
      padding-left: 0.9rem;
      border-left: 3px solid #c7d2fe;
      color: #6b7280;
    }
    .preview :global(code) {
      background: #f1f5f9;
      padding: 0.1rem 0.35rem;
      border-radius: 4px;
      font-size: 0.88em;
    }
    .preview :global(pre) {
      background: #f8fafc;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 0.8rem 1rem;
      overflow-x: auto;
    }
    .preview :global(pre code) {
      background: none;
      padding: 0;
    }
    .preview :global(a) { color: #2563eb; }

    .actions {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-top: 1rem;
    }
    .primary {
      font-family: inherit;
      font-size: 0.95rem;
      padding: 0.55rem 1.8rem;
      border: none;
      border-radius: 8px;
      background: #2563eb;
      color: #fff;
      cursor: pointer;
    }
    .primary:hover {
      background: #1d4ed8;
    }
    .primary:disabled {
      background: #93c5fd;
      cursor: default;
    }
    .status {
      font-size: 0.88rem;
      color: #6b7280;
      word-break: break-all;
    }
    .status--ok { color: #16a34a; }
    .status--error { color: #dc2626; }

    .offline {
      max-width: 34rem;
      margin: 6rem auto;
      padding: 0 1.5rem;
      font-family: system-ui, 'Microsoft YaHei', sans-serif;
      color: #1f2937;
    }
    .offline code {
      background: #f1f5f9;
      padding: 0.1rem 0.35rem;
      border-radius: 4px;
    }

    @media (max-width: 860px) {
      .meta {
        grid-template-columns: 1fr 1fr;
      }
      .panes {
        grid-template-columns: 1fr;
      }
      #editor {
        border-right: none;
        border-bottom: 1px solid #e5e7eb;
      }
    }
  </style>
</body>
</html>

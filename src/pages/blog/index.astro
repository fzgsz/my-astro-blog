---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 标签统计：用于标签云，点进去是独立的标签页
const tagCount = new Map();
for (const post of posts) {
	for (const tag of post.data.tags ?? []) {
		tagCount.set(tag, (tagCount.get(tag) ?? 0) + 1);
	}
}
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---
<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`全部文章 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main.blog-index {
				width: auto;
				max-width: 72rem;
				margin: 0 auto;
				padding: 2.5rem 1rem 0;
			}
			.page-head h1 {
				font-size: 2.2rem;
				margin: 0 0 0.35rem;
			}
			.page-head p {
				margin: 0 0 1.5rem;
				color: var(--muted);
				font-size: 0.95rem;
			}
			.tag-cloud {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 1.75rem;
			}
			.tag-cloud a {
				font-size: 0.82rem;
				color: var(--muted);
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: 999px;
				padding: 0.25rem 0.8rem;
				text-decoration: none;
				transition: color 0.15s ease, border-color 0.15s ease;
			}
			.tag-cloud a:hover {
				color: var(--accent);
				border-color: var(--chip-border);
			}
			.tag-cloud span {
				color: var(--muted);
				margin-left: 0.35rem;
				font-size: 0.75rem;
			}
			.card-list {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
				gap: 1rem;
			}
			.empty-tip {
				color: var(--muted);
				text-align: center;
				padding: 3rem 0;
			}
			@media (max-width: 640px) {
				.page-head h1 {
					font-size: 1.8rem;
				}
				.card-list {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="blog-index">
			<header class="page-head">
				<h1>全部文章</h1>
				<p>共 {posts.length} 篇 · 按发布时间倒序</p>
			</header>

			{
				tags.length > 0 && (
					<nav class="tag-cloud" aria-label="按标签浏览">
						{tags.map(([tag, count]) => (
							<a href={`/tags/${encodeURIComponent(tag)}`}>
								{tag}
								<span>{count}</span>
							</a>
						))}
					</nav>
				)
			}

			{
				posts.length === 0 ? (
					<p class="empty-tip">还没有文章，先去写一篇吧。</p>
				) : (
					<div class="card-list">
						{posts.map((post) => (
							<PostCard post={post} />
						))}
					</div>
				)
			}
		</main>
		<Footer />
	</body>
</html>
